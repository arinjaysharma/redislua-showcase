# Port for web server (Render sets PORT automatically)
PORT=8080

# Redis connection string (e.g. from Upstash)
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=

# Alternatively, for local Redis:
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── Grafana Cloud OTel Push (optional — telemetry is skipped if these are empty) ──
# Get these from: grafana.com → your stack → Connections → OTLP
# GRAFANA_OTLP_ENDPOINT format: https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_OTLP_ENDPOINT=
# Found in Grafana Cloud portal → your stack → Details → Instance ID
GRAFANA_INSTANCE_ID=
# A Grafana Cloud API token with MetricsPublisher + TracesPublisher roles
GRAFANA_API_KEY=
